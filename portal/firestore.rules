rules_version = '2';
// ══════════════════════════════════════════════════════════
// قواعد أمان Firestore الشاملة — جمعية إرث وحضارة بالقريات
// (الموقع العام + بوابة الموظفين والإجازات)
// انشرها عبر: Firebase Console → Firestore → Rules
// ══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── دوال التحقق المساعدة ──
    function signedIn() {
      return request.auth != null;
    }

    function hasPortalUser() {
      return signedIn() && exists(/databases/$(database)/documents/portal_users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/portal_users/$(request.auth.uid)).data;
    }

    function role() {
      return hasPortalUser() ? userDoc().get('role', '') : '';
    }

    function isTechAdmin() {
      return signedIn() && (
        request.auth.uid == 'dDcYQljmYFR1gq6cD0lG3wBaHys2' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == '2falilh2@gmail.com' ||
          request.auth.token.email.lower() == 'it@arthwhdarh.com'
        )) ||
        (hasPortalUser() && (userDoc().get('isTechAdmin', false) == true || userDoc().get('role', '') == 'tech_admin'))
      );
    }

    function isExec() {
      return signedIn() && (role() == 'executive' || isTechAdmin());
    }

    function isHR() {
      return signedIn() && (role() == 'hr' || isTechAdmin());
    }

    function myDept() {
      return hasPortalUser() ? userDoc().get('department', '') : '';
    }

    // ── التحقق الأمني من صلاحيات الإدارة للموقع ولوحة التحكم /admin ──
    function isSiteAdmin() {
      return signedIn() && (
        request.auth.uid == 'dDcYQljmYFR1gq6cD0lG3wBaHys2' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == '2falilh2@gmail.com' ||
          request.auth.token.email.lower() == 'it@arthwhdarh.com' ||
          request.auth.token.email.lower() == 'info@arthwhdarh.com' ||
          request.auth.token.email.lower().matches('.*@arthwhdarh[.]com$')
        )) ||
        (hasPortalUser() && (
          userDoc().get('isTechAdmin', false) == true ||
          userDoc().get('isAdmin', false) == true ||
          userDoc().get('role', '') in ['admin', 'tech_admin', 'executive', 'hr', 'general_manager', 'board_chairman', 'exec', 'manager']
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isTechAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'tech_admin', 'executive', 'hr', 'general_manager', 'board_chairman', 'exec', 'manager']
        ))
      );
    }

    // ════════════════ بوابة الموظفين ════════════════

    // ── حسابات الموظفين (portal_users) ──
    // آليات التأسيس الآمنة (Bootstrap):
    // 1) المسؤول التقني ينشئ أي حساب للموظفين.
    // 2) يتاح إنشاء الحساب الأول للمستخدم المصادق حديثاً لتأسيس مستنده إذا لم يكن موجوداً من قبل.
    match /portal_users/{uid} {
      allow read: if signedIn();
      allow create: if isTechAdmin()
                    || (signedIn() && request.auth.uid == uid && !exists(/databases/$(database)/documents/portal_users/$(uid)));
      allow delete: if isTechAdmin();
      allow update: if isTechAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isTechAdmin', 'status']));
    }

    // ── طلبات الإجازات (portal_leaves) ──
    match /portal_leaves/{id} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isHR() ||
        isExec()
      );
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.status == 'submitted' || !('status' in request.resource.data));
      allow update: if signedIn() && (
        // HR updates: HR can review/reject or forward to Exec ('hr_approved'), but CANNOT set status to 'approved'
        (isHR() &&
         (resource.data.status == 'submitted' || resource.data.status == 'in_hr_review') &&
         request.resource.data.status != 'approved')
        ||
        // Executive updates: Executive can approve ('approved') or reject ('exec_rejected')
        (isExec() &&
         (resource.data.status == 'hr_approved' || resource.data.status == 'submitted' || resource.data.status == 'in_hr_review'))
      );
      allow delete: if isTechAdmin() || (signedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'submitted');
    }

    // ── المهام (portal_tasks) ──
    match /portal_tasks/{id} {
      allow read: if signedIn() && (resource.data.employeeId == request.auth.uid || resource.data.isGroup == true || isExec());
      allow create: if isExec();
      allow delete: if false;
      allow update: if signedIn() && (
        (isExec() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rejectionReason']))
        ||
        (resource.data.employeeId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'description', 'dueDate', 'priority', 'adminId', 'employeeId', 'attachmentRequired']))
      );

      // Sub‑collection for per‑employee executions of a group task
      match /executions/{uid} {
        // Executives can read/write any execution
        allow read, write: if isExec();
        // Individual employee can read/write only their own execution
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ── المهام الشخصية والملاحظات (portal_personal_tasks) ──
    match /portal_personal_tasks/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isExec());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isExec());
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isExec());
    }

    // ── الملفات العامة والإدارية (portal_files) ──
    match /portal_files/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isExec() || (signedIn() && resource.data.uploadedBy == request.auth.uid);
      allow delete: if isExec() || (signedIn() && resource.data.uploadedBy == request.auth.uid);
    }

    // ── الاقتراحات والشكاوى (portal_suggestions_complaints) ──
    match /portal_suggestions_complaints/{id} {
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── الإشعارات (portal_notifications) ──
    match /portal_notifications/{id} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'dept:all' ||
        ('department' in userDoc() && resource.data.userId == ('dept:' + userDoc().department)) ||
        (isHR() && resource.data.userId == 'dept:hr') ||
        (isExec() && resource.data.userId == 'dept:executive') ||
        isTechAdmin()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'dept:all' ||
        ('department' in userDoc() && resource.data.userId == ('dept:' + userDoc().department)) ||
        (isHR() && resource.data.userId == 'dept:hr') ||
        (isExec() && resource.data.userId == 'dept:executive') ||
        isTechAdmin()
      );
      allow delete: if isExec() || isTechAdmin();
    }


    // ── رموز FCM (portal_fcm_tokens) ──
    match /portal_fcm_tokens/{token} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isExec());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isExec());
    }

    // ── الحضور والانصراف (portal_attendance) ──
    match /portal_attendance/{id} {
      allow read: if signedIn();

      // إنشاء سجل الحضور: الموظف ينشئ سجله الخاص لليوم فقط، أو الموارد البشرية والمدير
      allow create: if (signedIn() && request.auth.uid == request.resource.data.employeeUid
                        && id == request.auth.uid + "_" + request.resource.data.date
                        && request.resource.data.method == "electronic")
                    || isHR() || isExec() || isTechAdmin();

      // تحديث سجل الحضور (تسجيل الانصراف أو تعديل HR): يمنع تعديل UID أو التاريخ أو وقت الإنشاء للموظف
      allow update: if (signedIn() && request.auth.uid == resource.data.employeeUid
                        && request.resource.data.employeeUid == resource.data.employeeUid
                        && request.resource.data.date == resource.data.date
                        && request.resource.data.createdAt == resource.data.createdAt)
                    || isHR() || isExec() || isTechAdmin();

      allow delete: if isHR() || isExec() || isTechAdmin();
    }

    // ── التعميمات والإعلانات الداخلية (portal_announcements) ──
    match /portal_announcements/{id} {
      // قراءة وثائق التعميمات المتاحة للمستخدمين المسجلين (التصفية بحسب المستهدفين تتم في العميل)
      allow read: if signedIn();
      allow create: if isExec() || isTechAdmin();
      allow update: if isExec() || isTechAdmin();
      allow delete: if isExec() || isTechAdmin();

      // سجل المشاهدات (views) — محمي أمنياً: المدير يقرأ جميع المشاهدات، والموظف يقرأ ويسجل وثيقة مشاهدته الشخصية فقط
      match /views/{uid} {
        allow read: if isExec() || isTechAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isExec() || isTechAdmin();
      }
    }

    // ════════════════ الموقع العام ولوحة الإدارة (/admin) ════════════════

    // ── المتطوعون ──
    match /volunteers/{id} {
      allow create: if true;
      allow read, update, delete: if isSiteAdmin();
    }

    // ── الحرف والأعمال اليدوية ──
    match /crafts/{id} {
      allow create: if true;
      allow read, update, delete: if isSiteAdmin();
    }

    // ── الورش التدريبية ──
    match /workshops/{id} {
      allow read: if true;
      allow create, delete: if isSiteAdmin();
      allow update: if isSiteAdmin() ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']));
    }

    // ── الفرص التطوعية ──
    match /volunteerOpportunities/{id} {
      allow read: if true;
      allow create, update, delete: if isSiteAdmin();
    }

    // ── طلبات التطوع ──
    match /volunteer_applications/{id} {
      allow create: if true;
      allow read, update, delete: if isSiteAdmin();
    }

    // ── تسجيلات الورش التدريبية ──
    match /workshop_registrations/{id} {
      allow create: if true;
      allow read, update, delete: if isSiteAdmin();
    }

    // ── الأخبار والمقالات ──
    match /news/{id} {
      allow read: if true;
      allow create, update, delete: if isSiteAdmin();
    }

    // ── إعدادات الموقع العام ──
    match /settings/{id} {
      allow read: if true;
      allow write: if isSiteAdmin();
    }

    // ── إشعارات الأدمن (طلب تسجيل زوار الموقع العام) ──
    match /admin_notifications/{id} {
      allow create: if true;
      allow read, update, delete: if isSiteAdmin();
    }

    // ── الاستبيانات الخاصة بورش العمل (surveys) ──
    match /surveys/{id} {
      // قراءة الاستبيان متاحة للجمهور (لقراءة الاستبيانات المنشورة) وللمدير
      allow read: if true;
      // الإنشاء والتعديل والحذف محصور بالإدارة فقط
      allow create, update, delete: if isSiteAdmin();
    }

    // ── إجابات الاستبيانات (survey_responses) ──
    match /survey_responses/{id} {
      // تتيح للمشارك إرسال إجابته فقط إن لم تكن موجودة مسبقاً لمنع التكرار على مستوى قاعدة البيانات
      allow create: if !exists(/databases/$(database)/documents/survey_responses/$(id));
      // قراءة التقييمات والإحصائيات وتعديلها وحذفها محصورة بمديري النظام لحفظ الخصوصية
      allow read, update, delete: if isSiteAdmin();
    }

    // ── حسابات مديري النظام ومستخدمي لوحة الإدارة ──
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSiteAdmin());
      allow write: if isSiteAdmin();
    }

    // ════════════════ سحابة إرث وحضارة (Cloud Platform) ════════════════
    // ── روابط المشاركة (cloud_shares) ──
    match /cloud_shares/{shareId} {
      // قراءة بيانات الرابط المشترك للجمهور العام (كلمة المرور مشفرة بـ Salted SHA-256)
      allow read: if true;
      // إنشاء الرابط مسموح للمستخدمين المعتمدين في الجمعية فقط
      allow create: if signedIn();
      // التعديل والإلغاء محصور بمالك الرابط أو المسؤول التقني أو زيادة عداد المشاهدات
      allow update: if (signedIn() && (resource.data.createdBy == request.auth.uid || isTechAdmin()))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'downloadCount']));
      // الحذف محصور بالمالك أو المسؤول التقني
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isTechAdmin());
    }

    // ── العناصر المفضلة (cloud_favorites) ──
    match /cloud_favorites/{favId} {
      allow read, write: if signedIn();
    }
  }
}
